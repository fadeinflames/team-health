# Скопируй в .env и заполни секреты: make env
# make env создаёт .env из этого файла и сразу генерирует случайные значения
# для ADMIN_PASSWORD, SURVEY_RESPONSE_SECRET, DEMO_PASSWORD и POSTGRES_PASSWORD.
#
# Секреты в этом файле пустые не по недосмотру: рабочего значения в
# репозитории не должно быть ни одного. Заполняет их make secrets.

# Режим развёртывания: local | production.
# production включает: обязательные ADMIN_PASSWORD и SURVEY_RESPONSE_SECRET,
# отказ стартовать без DATABASE_URL, флаг Secure у session-cookie,
# доверие к X-Forwarded-For и блокировку /api/reset.
# Если не задан, определяется автоматически: production при наличии RAILWAY_ENVIRONMENT, иначе local.
APP_ENV=local

# Порт HTTP-сервера. На Railway задаётся платформой.
PORT=4173

# PostgreSQL. Без этой переменной данные пишутся в файл (см. DATA_DIR).
# DATABASE_URL=postgres://team_health:team_health@127.0.0.1:5433/team_health

# SSL для подключения к PostgreSQL: require | verify-full | disable.
# Если не задать, node-postgres читает sslmode из самой строки подключения.
# DATABASE_SSL=disable

# Размер пула соединений. По умолчанию 10.
# DATABASE_POOL_MAX=10

# Каталог file-хранилища. Работает только когда DATABASE_URL не задан.
DATA_DIR=./.data

# Учётная запись администратора.
# Пароля по умолчанию не существует: вне local его отсутствие — отказ старта,
# в local он генерируется при первом запуске и печатается один раз.
# Смена ADMIN_PASSWORD применяется при рестарте и сбрасывает сессии админа.
# Ротация без рестарта: make admin-password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Отображаемое имя админа. По умолчанию «Администратор».
# ADMIN_NAME=

# Демо-доступ к универсальному 1:1. Создаётся сидингом (make seed), не приложением.
DEMO_USERNAME=demo
DEMO_PASSWORD=

# Секрет для server-side hash анонимных ответов на опросы.
# Совпадать с ADMIN_PASSWORD не может: список userId админу доступен, и общий
# секрет позволил бы сопоставить анонимный ответ с автором.
# Смена секрета инкрементирует поколение хешей, старые ответы остаются в своём.
SURVEY_RESPONSE_SECRET=

# Осознанный запуск production без PostgreSQL. Данные переживут только жизнь контейнера.
# ALLOW_FILE_STORAGE=1

# Включает опасный endpoint /api/reset в production. Нужен тестам, в бою не включать.
# ENABLE_DEMO_RESET=1

# Доверять X-Forwarded-For при rate-limit логина. В production включено само.
# Ставить только если перед приложением реально стоит прокси.
# TRUST_PROXY=1

# Сколько ждать активные запросы при SIGTERM, прежде чем выйти принудительно.
SHUTDOWN_TIMEOUT_MS=10000

# Куда vite dev server проксирует /api. В docker compose — http://api:4173.
VITE_API_TARGET=http://127.0.0.1:4173

# --- только для docker compose ---

# Порты, которые compose пробрасывает на хост.
# 5433, а не 5432: на машине разработчика 5432 обычно занят своим постгресом.
POSTGRES_PORT=5433
API_PORT=4173
WEB_PORT=5173
PROD_PORT=8080

# Учётка postgres в compose. Строка подключения собирается из них автоматически.
# Смена POSTGRES_PASSWORD требует пересоздания volume: make down-v.
POSTGRES_USER=team_health
POSTGRES_PASSWORD=
POSTGRES_DB=team_health

# Пароль админа для профиля prod: там APP_ENV=production, и приложение
# требует пароль длиннее 12 символов, которого нет в блок-листе.
PROD_ADMIN_PASSWORD=
