{
  "name": "team-health-121",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Team management platform for 1:1 meetings, development plans, goals, surveys, reports, and competency mapping.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.js",
    "check": "vite build",
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke.spec.js",
    "test:ui": "playwright test tests/ui-audit.spec.js",
    "migrate": "node scripts/migrate.mjs up",
    "migrate:status": "node scripts/migrate.mjs status",
    "migrate:baseline": "node scripts/migrate.mjs baseline",
    "migrate:new": "node scripts/migrate.mjs create",
    "seed": "node scripts/seed.mjs",
    "secrets": "node scripts/secrets.mjs init",
    "secrets:check": "node scripts/secrets.mjs check",
    "admin-password": "node scripts/admin-password.mjs rotate"
  },
  "dependencies": {
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.552.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^8.0.10"
  }
}
